# 后端运行时配置示例：复制为 .env 后填入自己的真实值
HOST=0.0.0.0
PORT=8001
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- 数据库 ----
# 注意：密码中的 @ 在 URL 里要写成 %40
DATABASE_URL=mysql+pymysql://root:你的MySQL密码@127.0.0.1:3306/ai_chat?charset=utf8mb4

# JWT 密钥：换成长随机串
JWT_SECRET=please-change-me
JWT_EXPIRE_MINUTES=1440
BCRYPT_ROUNDS=12

ENGINE_BACKEND=mock
LOCAL_MODEL_DIR=./models

# ---- 远端 API（DeepSeek）----
REMOTE_PROVIDERS=deepseek
REMOTE_DEEPSEEK_KEY=sk-在这里填你的DeepSeekKey
REMOTE_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
REMOTE_DEEPSEEK_MODEL=deepseek-chat
